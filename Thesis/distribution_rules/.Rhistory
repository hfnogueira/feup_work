for (col in names(df)) {
if (col == 'Wine_mhl') {
df[[col]] = as.numeric(df[[col]])
} else{
df[[col]] = as.factor(df[[col]])
}
cat(col,'---',class(df[[col]]),'\n')
}
df_test = df
ts.plot(df_test$Wine_mhl)
drs <- caren(df_test, Dist=TRUE, POI='Wine_mhl',min.sup = 0.2, min.conf = 0.1)
drs
# View rules
plot.drs(drs)
df_test
# View rules
plot.drs(drs)
drs
# View rules
plot.drs(drs)
